# Copy to .env and fill in values before running docker-compose
# Never commit .env to version control

# PostgreSQL
POSTGRES_USER=ecg_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ecg_pipeline

# Kafka (used by producer and consumer)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Spark local mode — no cluster needed
# Ensure JAVA_HOME is set on your machine (JDK 11 or 17 required)
# Windows example: C:\Program Files\Eclipse Adoptium\jdk-11.0.20.8-hotspot
JAVA_HOME=

# PostgreSQL JDBC URL for Spark consumer
POSTGRES_URL=jdbc:postgresql://localhost:5432/ecg_pipeline
